# 分你一只耳机 · 配置示例。复制成 .env 再填；.env 永远不要提交。
PORT=8787
# 访问口令：随便一串足够长的字符。前端在 localStorage 里存 one-earbud.token 带上它
ONE_EARBUD_TOKEN=
# 独立的 MCP 访问口令，不能与网页口令相同；留空时 /mcp 关闭
MCP_AUTH_TOKEN=
# 公网 origin，不带 /mcp；Render 自动使用 RENDER_EXTERNAL_URL。自定义域名时填写
MCP_PUBLIC_URL=
# 额外 OAuth 回调 URL（逗号分隔、精确匹配）；默认支持 ChatGPT 官方回调
MCP_OAUTH_REDIRECT_URIS=
# 本机文件目录；Render Free 使用 /tmp/one-earbud，仅临时保存队列等数据
ONE_EARBUD_DATA_DIR=./data
# 免费实例跨重启保留网易云登录及 OAuth：填写 Neon Free 连接串，只填到 Render 环境变量
ONE_EARBUD_AUTH_DATABASE_URL=
# 独立的至少 32 字符随机加密密钥；长期保留，勿更换，不与两个访问口令共用
ONE_EARBUD_AUTH_ENCRYPTION_KEY=
# 两项留空则使用本机 netease-auth.json / oauth-state.json，Render Free 重启/部署后仍会丢失
# 可选：出口 IP 在海外时，网易云会拒；填一个国内 IP 当 X-Real-IP
NETEASE_REAL_IP=
