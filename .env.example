# 分你一只耳机 · 配置示例。复制成 .env 再填；.env 永远不要提交。
PORT=8787
# 访问口令：随便一串足够长的字符。前端在 localStorage 里存 one-earbud.token 带上它
ONE_EARBUD_TOKEN=
# 独立的 MCP 访问口令，不能与网页口令相同；留空时 /mcp 关闭
MCP_AUTH_TOKEN=
# 公网 origin，不带 /mcp；Render 自动使用 RENDER_EXTERNAL_URL。自定义域名时填写
MCP_PUBLIC_URL=
# 额外 OAuth 回调 URL（逗号分隔、精确匹配）；默认支持 ChatGPT 官方回调
MCP_OAUTH_REDIRECT_URIS=
# 数据目录：网易云登录态、播放列表存在这里（登录态文件权限 0600）
ONE_EARBUD_DATA_DIR=./data
# Render 请挂载磁盘到 /var/data，并设置 ONE_EARBUD_DATA_DIR=/var/data/one-earbud
# 可选：出口 IP 在海外时，网易云会拒；填一个国内 IP 当 X-Real-IP
NETEASE_REAL_IP=
